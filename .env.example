# Copy this file to .env for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# TiDB Cloud example: mysql://xxxx.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/pabbly_flows
DATABASE_URL=mysql://root:password@127.0.0.1:3306/pabbly_flows

# true for TiDB Cloud / any hosted MySQL that requires TLS, false for local MySQL
DB_SSL=false

# Long random string (48+ chars). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# How long a login stays valid, in days
SESSION_DAYS=7

# Local API port (Vite proxies /api to it)
PORT=4000
