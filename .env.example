# Copy this file to .env for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# TiDB Cloud example: mysql://xxxx.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/pabbly_flows
DATABASE_URL=mysql://root:password@127.0.0.1:3306/pabbly_flows

# true for TiDB Cloud / any hosted MySQL that requires TLS, false for local MySQL
DB_SSL=false

# Long random string (48+ chars). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# How long a login stays valid, in days
SESSION_DAYS=7

# ── Email for login codes (OTP) ─────────────────────────────────────────────
# Leave SMTP_HOST empty for local development: codes are then printed in the
# "npm run dev" terminal. On Vercel these are REQUIRED or nobody can log in.
#
# Zoho Mail:  SMTP_HOST=smtp.zoho.in       SMTP_PORT=465  (use an app-specific password)
# Gmail:      SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  (needs 2-Step Verification + App Password)
# Brevo:      SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 (SMTP key from Brevo → SMTP & API)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox. Must be an address your SMTP account is allowed to send from.
MAIL_FROM="Pabbly Flow Manager <no-reply@yourdomain.com>"

# Local API port (Vite proxies /api to it)
PORT=4000
